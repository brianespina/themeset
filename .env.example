# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit .env.local — Next.js loads it automatically and it's already
# excluded via the default Next.js .gitignore.

# ── Pricing ──────────────────────────────────────────────────────────────────

# SteamAnalyst API key (https://www.steamanalyst.com/api_info).
# Server-side only: read in src/lib/steamanalyst/client.ts, never sent to the
# browser. Do NOT prefix this with NEXT_PUBLIC_. Free Hobby tier is 100
# requests/day, single-item lookup only — see src/lib/pricing/refresh.ts.
STEAMANALYST_API_KEY=

# Shared secret for the daily price-refresh cron endpoint
# (/api/cron/refresh-prices) — whoever/whatever triggers it (Vercel Cron,
# GitHub Actions, etc.) must send `Authorization: Bearer <this value>`.
CRON_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────

# Postgres connection string for Prisma. With Supabase this is the project's
# Postgres URL: Supabase → Settings → Database → Connect → Session pooler.
#
# Do NOT use the "Direct connection" string the dashboard shows by default:
# db.<ref>.supabase.co resolves IPv6-only, and IPv4 there is a paid add-on, so
# it fails with "Network is unreachable" from most networks.
#
# LOCAL: point both at the SESSION pooler (port 5432).
# VERCEL/serverless: DATABASE_URL becomes the TRANSACTION pooler (port 6543,
# `?pgbouncer=true&connection_limit=1`) because each function instance opens
# its own connection; DIRECT_URL stays on 5432 because pgBouncer's transaction
# mode cannot run migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth (Supabase) ──────────────────────────────────────────────────────────

# Supabase → Settings → API keys. The publishable key is safe in the browser —
# that's what it's for — and NEXT_PUBLIC_ is required for the browser client
# that starts the OAuth redirect.
#
# Leaving these blank is a supported state: the site still renders, just
# permanently signed out, the same way a missing SteamAnalyst key falls back to
# the community catalog. See src/lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Settings → API keys → secret key (`sb_secret_…`). SECRET: bypasses
# Row Level Security. Needed only by the Steam sign-in flow, which has to create
# an auth user for an identity Supabase has no provider for. Never prefix with
# NEXT_PUBLIC_ and never import src/lib/supabase/admin.ts from client code.
SUPABASE_SECRET_KEY=

# Legacy JWT key names from before Supabase's prefixed API keys. Still honoured
# as a fallback (src/lib/supabase/env.ts) for older projects; new projects only
# issue the prefixed keys above, so leave these unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Steam sign-in (optional) ─────────────────────────────────────────────────

# Steam Web API key (https://steamcommunity.com/dev/apikey). Optional: without
# it Steam sign-in still works, users just get a generated username instead of
# their Steam persona name and avatar.
STEAM_WEB_API_KEY=

# Domain for the synthetic, non-deliverable address each Steam account is filed
# under in Supabase Auth (Steam never gives us an email). Only set this if the
# default collides with real sign-ups.
# STEAM_EMAIL_DOMAIN=steam.themeset.invalid
